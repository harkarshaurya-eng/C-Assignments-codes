// operator overloading 

#include<iostream>
using namespace std;

class Number
{
    int x;

public:
    Number(int a = 0)
    {
        x = a;
    }

    // Operator Overloading
    Number operator + (Number obj)
    {
        Number temp;
        temp.x = x + obj.x;
        return temp;
    }

    void display()
    {
        cout << "Result = " << x;
    }
};

int main()
{
    Number n1(10), n2(20), n3;

    n3 = n1 + n2;

    n3.display();

    return 0;
}
