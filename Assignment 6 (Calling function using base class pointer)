//using the pointer to the base class to call the derived class function


#include<iostream>
using namespace std;

class Base
{
public:
    virtual void show()
    {
        cout << "Base Class Function" << endl;
    }
};

class Derived : public Base
{
public:
    void show()
    {
        cout << "Derived Class Function" << endl;
    }
};

int main()
{
    Derived d;

    Base *ptr;
    ptr = &d;

    ptr->show();

    return 0;
}
