// example of function overloading 
// by using different types of datatypes


#include<iostream>
using namespace std;

class Demo
{
public:
    void add(int a, int b)
    {
        cout << "Integer Sum = " << a + b << endl;
    }

    void add(float a, float b)
    {
        cout << "Float Sum = " << a + b << endl;
    }

    void add(int a, int b, int c)
    {
        cout << "Three Integer Sum = " << a + b + c << endl;
    }
};

int main()
{
    Demo d;

    d.add(10, 20);
    d.add(2.5f, 3.5f);
    d.add(1, 2, 3);

    return 0;
}
